APP_ENV=development
DATABASE_URL=sqlite:///./medbrief.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=512
OCR_LANG=en
NNUNET_COMMAND=
NNUNET_RESULTS_DIR=
MRI_MODEL_NAME=
MRI_MIN_CONFIDENCE=0.5
CLINICAL_INTEL_ENABLED=true
USE_MOCK_LLM=true
QWEN_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct
MEDBRIEF_DEVICE=auto

# LLM Providers Configuration
# Available providers: mock, huggingface, gemini, openai, ollama
LLM_PROVIDER=mock
CHATBOT_ONLY_LLM=true

# Google Gemini API Config
GEMINI_API_KEY=

# OpenAI API Config
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama local API Config
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

